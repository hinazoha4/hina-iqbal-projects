library ieee;
use ieee.std_logic_1164.all;
use ieee.numeric_std.all;   

entity vga_sync is
  Port (
    clk       : in  std_logic;
    reset     : in  std_logic;
    char_data : in  std_logic_vector(7 downto 0); -- ASCII code
    hsync, vsync : out std_logic;
    red, green, blue : out std_logic_vector(3 downto 0)
  );
end vga_sync;

architecture Behavioral of vga_sync is
    signal h_counter : unsigned(9 downto 0);  
    signal v_counter : unsigned(9 downto 0);
begin
  process(clk)
  begin
    if rising_edge(clk) then
      if h_count = 799 then
        h_count <= (others => '0');
        if v_count = 524 then
          v_count <= (others => '0');
        else
          v_count <= v_count + 1;
        end if;
      else
        h_count <= h_count + 1;
      end if;
    end if;
  end process;

  hsync <= not (unsigned(h_count) >= 656 and unsigned(h_count) < 752);
  vsync <= not (unsigned(v_count) >= 490 and unsigned(v_count) < 492);


  -- Simple color test pattern
  red   <= "1111" when h_count < 640 and v_count < 480 else "0000";
  green <= "0000";
  blue  <= "0000";
end Behavioral;


