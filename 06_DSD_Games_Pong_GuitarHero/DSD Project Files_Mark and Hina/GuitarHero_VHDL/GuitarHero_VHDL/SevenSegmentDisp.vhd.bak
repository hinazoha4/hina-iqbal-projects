LIBRARY ieee;
USE ieee.std_logic_1164.all;

ENTITY Lab_07 IS

	PORT (A, B, C, D, E : In STD_LOGIC ;
			outA, outB, outC, outD, outE, outF, outG, h, i, j, k, l, m, n : OUT STD_LOGIC) ;
			
END Lab_07;

ARCHITECTURE SevenSegmentDisp OF Lab_07 IS
BEGIN
	
	--outA <= NOT ((B AND C) OR (NOT B AND NOT D) OR (NOT A AND C AND D) OR (NOT A AND B AND D) OR (NOT C AND NOT D AND A) OR (NOT B AND NOT C AND A));
	outA <= not((not B and D) or (A and D) or (not A and not C and not E) or (not A and C and E) or (A and not B and not E) or (A and not C and E) or (not A and B and not D));
	
	--outB <= NOT ((NOT B AND NOT D) OR (NOT A AND NOT B) OR (NOT A AND NOT C AND NOT D) OR (NOT A AND C AND D) OR (NOT C AND A AND D));
	outB <= not((not A and not C) or (B and C and not D) or (A and not B and E) or (not B and D and E) or (not A and B and not E) or (A and not B and D) or (C and not D and not E) or (B and not D and not E));
	
	--outC <= NOT ((NOT A AND B) OR (A AND NOT B) OR (NOT C AND D) OR (NOT A AND D) OR (NOT A AND NOT C));
	outC <= not(E or (B and not C) or (not B and not D) or (A and not C) or (not A and C and D));
	
	--outD <= NOT ((NOT A AND NOT B AND NOT D) OR (NOT B AND C AND D) OR (B AND NOT C AND D) OR (B AND C AND NOT D) OR (A AND NOT C AND NOT D));
	outD <= not((not A and not C and not E) or (not B and D and not E) or (not C and D and not E) or (A and not B and not E) or (B and C and not D) or (B and C and E) or (A and C and D) or (A and B and E) or (not A and not B and not C and D) or (not A and C and not D and E));
	
	--outE <= NOT ((NOT B AND NOT D) OR (C AND NOT D) OR (A AND B) OR (A AND C));
	outE <= not((not A and not C and not E) or (not B and D and not E) or (not C and D and not E) or (A and not B and not E) or (not A and B and not D and not E));
	
	--outF <= NOT ((NOT C AND NOT D) OR (NOT A AND B AND NOT C) OR (B AND NOT D) OR (A AND C) OR (A AND NOT B));
	outF <= not((not B and not D and not E) or (B and not C and not D) or (B and not C and not E) or (B and C and D) or (A and not C and D) or (not A and not B and C and not D) or (not A and not B and C and not E));
	
	--outG <= NOT ((A AND D) OR (A AND NOT B) OR (C AND NOT D) OR (NOT A AND NOT B AND C) OR (NOT A AND B AND NOT C));
	outG <= not((B and not D) or (B and C) or (A and D) or (not B and not C and D) or (not B and D and not E) or (not A and C and not D) or (A and not C and not E));
	
	h <= not((not A and not B) OR (not B and C) or (A and b) or (not A and not C and not D));
	
	i <= '0';
	
	j <= not((not A) or (not B and not C));
	
	k <= not((not A and not B) OR (not B and C) or (A and B) or (not A and not C and not D));
	
	l <= not((not A and not B) OR (not B and C) or (A and B) or (not A and not C and not D));
	
   m <= not((not A and not B) or (not A and not C and not D));

	n <= not((A and C) or (A and B));
	
END SevenSegmentDisp;