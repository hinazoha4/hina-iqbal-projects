--synthesis_resources = lut 6 
SUBDESIGN mux_fib
( 
	data[11..0]	:	input;
	result[5..0]	:	output;
	sel[0..0]	:	input;
) 
VARIABLE 
	result_node[5..0]	: WIRE;
	sel_node[0..0]	: WIRE;
	w_data123w[1..0]	: WIRE;
	w_data137w[1..0]	: WIRE;
	w_data149w[1..0]	: WIRE;
	w_data161w[1..0]	: WIRE;
	w_data173w[1..0]	: WIRE;
	w_data185w[1..0]	: WIRE;

BEGIN 
	result[] = result_node[];
	result_node[] = ( ((sel_node[] & w_data185w[1..1]) # ((! sel_node[]) & w_data185w[0..0])), ((sel_node[] & w_data173w[1..1]) # ((! sel_node[]) & w_data173w[0..0])), ((sel_node[] & w_data161w[1..1]) # ((! sel_node[]) & w_data161w[0..0])), ((sel_node[] & w_data149w[1..1]) # ((! sel_node[]) & w_data149w[0..0])), ((sel_node[] & w_data137w[1..1]) # ((! sel_node[]) & w_data137w[0..0])), ((sel_node[] & w_data123w[1..1]) # ((! sel_node[]) & w_data123w[0..0])));
	sel_node[] = ( sel[0..0]);
	w_data123w[] = ( data[6..6], data[0..0]);
	w_data137w[] = ( data[7..7], data[1..1]);
	w_data149w[] = ( data[8..8], data[2..2]);
	w_data161w[] = ( data[9..9], data[3..3]);
	w_data173w[] = ( data[10..10], data[4..4]);
	w_data185w[] = ( data[11..11], data[5..5]);
END;
